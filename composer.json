{
  "name": "candidate/alcor-payroll-poc",
  "description": "Proof of concept for manual adjustments to an earning line",
  "type": "project",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Alcor\\Payroll\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Alcor\\Payroll\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --level=max src tests"
  },
  "config": {
    "sort-packages": true
  }
}